{
  "name": "buildnight-squad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "lint:tema": "bun scripts/lint-tema.ts",
    "prebuild": "bun run lint:tema",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
